    <!-- Quiz Questions -->
    <string name="quiz_q1">What percentage of Indian Railways is electrified?</string>
    <string-array name="quiz_q1_options">
        <item>50%</item>
        <item>90%</item>
        <item>70%</item>
        <item>95%</item>
    </string-array>
    <string name="quiz_q1_explanation">As of 2024, over 90% of Indian Railways is electrified!</string>
    
    <string name="quiz_q2">How much CO2 does rail save vs road per km?</string>
    <string-array name="quiz_q2_options">
        <item>80%</item>
        <item>50%</item>
        <item>70%</item>
        <item>90%</item>
    </string-array>
    <string name="quiz_q2_explanation">Rail transport produces about 80% less CO2 than road transport.</string>
    
    <string name="quiz_q3">What is regenerative braking?</string>
    <string-array name="quiz_q3_options">
        <item>Using solar panels</item>
        <item>Using wind power</item>
        <item>Manual braking</item>
        <item>Converting kinetic energy to electricity</item>
    </string-array>
    <string name="quiz_q3_explanation">Regenerative braking converts the train\'s kinetic energy back into electricity when slowing down.</string>
    
    <string name="quiz_q4">How many stations in India are solar-powered?</string>
    <string-array name="quiz_q4_options">
        <item>100+</item>
        <item>960+</item>
        <item>500+</item>
        <item>1500+</item>
    </string-array>
    <string name="quiz_q4_explanation">Over 960 railway stations in India now run on solar power!</string>
    
    <string name="quiz_q5">What is Indian Railways\' net-zero target year?</string>
    <string-array name="quiz_q5_options">
        <item>2030</item>
        <item>2025</item>
        <item>2040</item>
        <item>2050</item>
    </string-array>
    <string name="quiz_q5_explanation">Indian Railways aims to become net-zero carbon emitter by 2030.</string>
    
